# ==============================================================================
# VultaCore Platform — Environment Configuration Template
# Copy this file to .env or .env.local and populate with your credentials.
# NEVER COMMIT .env OR REAL SECRETS TO SOURCE CONTROL.
# ==============================================================================

# ── 1. Master Proxy & Runtime (server.js) ────────────────────────────────────
NODE_ENV=production
PORT=3000

# Secret key required to access /logs and /api/boot-logs in production
ADMIN_KEY=your_secure_random_admin_key_here

# ── 2. Administrative Privileges & RBAC ───────────────────────────────────────
# Email address granted full administrator privileges
ADMIN_EMAIL=mohtasham.siddiqui17@gmail.com

# ── 3. Database Connection ───────────────────────────────────────────────────
# Leave blank to use local saas.sqlite file. For production PostgreSQL (Supabase/Hostinger):
# DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Set to true only if self-signed SSL certificate is required for database
DB_SSL_INSECURE=false

# ── 4. Supabase Auth & Storage Integration ────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_public_key

# Backend service role key (NEVER expose to frontend or client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret

# ── 5. URLs & Public Routing ─────────────────────────────────────────────────
APP_URL=https://vultacore.techprogression.com
NEXT_PUBLIC_APP_URL=https://vultacore.techprogression.com
NEXT_PUBLIC_API_URL=https://vultacore.techprogression.com/api
BACKEND_URL=http://localhost:3001

# ── 6. Lemon Squeezy Billing & Webhook Gateway ────────────────────────────────
LS_API_KEY=your_lemon_squeezy_api_key
LS_STORE_ID=410740
LS_WEBHOOK_SECRET=your_lemon_squeezy_webhook_signing_secret

# Plan Variant IDs from Lemon Squeezy Dashboard
LS_VARIANT_STANDARD=1820715
LS_VARIANT_PREMIUM=1820708
LS_VARIANT_ENTERPRISE=1860093
NEXT_PUBLIC_LS_STORE_ID=410740
NEXT_PUBLIC_LS_VARIANT_STANDARD=1820715
NEXT_PUBLIC_LS_VARIANT_PREMIUM=1820708
NEXT_PUBLIC_LS_VARIANT_ENTERPRISE=1860093

# ── 7. AI Microservice Keys (ai-services/main.py) ─────────────────────────────
GEMINI_API_KEY=your_google_gemini_api_key
GROQ_API_KEY=your_groq_cloud_api_key
OPENROUTER_API_KEY=your_openrouter_api_key

