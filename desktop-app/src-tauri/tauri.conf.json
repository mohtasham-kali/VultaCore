{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VultaCore",
  "version": "0.1.0",
  "identifier": "com.vultacore.app",
  "build": {
    "frontendDist": "../../web-dashboard/out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VultaCore",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/mohtasham-kali/VultaCore/releases/latest/download/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXkKZWdnd2RUZXN0aW5nS2V5UGFpcjEyMzQ1Njc4OTA="
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
