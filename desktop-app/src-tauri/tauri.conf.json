{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VultaCore",
  "version": "0.1.0",
  "identifier": "com.vultacore.desktop",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../web-dashboard/out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VultaCore",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:* ws://localhost:*; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:*; connect-src 'self' http://localhost:* ws://localhost:*; img-src 'self' data: http://localhost:*;"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["vultacore"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/mohtasham-kali/VultaCore/releases/latest/download/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBNTE4MzMxQTlCQzdENTgKUldSWWZieXBNWU5SU29oazhxTXNOK3B5RmVQempMSCtJRFJtNGpWQzVLK0ZkdFViZUZoS3ZWWDUK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
