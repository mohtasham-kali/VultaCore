# ─────────────────────────────────────────────────────────────────────────────
# VultaCore Backend Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# Database (leave blank to use local SQLite for dev)
DATABASE_URL=

# App public URL (used for Lemon Squeezy redirect_url)
APP_URL=http://localhost:3000

# ─── Lemon Squeezy ──────────────────────────────────────────────────────────
# 1. Sign up at https://lemonsqueezy.com
# 2. Go to Settings → API → Create API Key
LS_API_KEY=your_lemon_squeezy_api_key_here

# 3. Go to your Store → Settings → copy the numeric Store ID
LS_STORE_ID=12345

# 4. Create two Products in your LS dashboard (Standard & Premium)
#    Under each product, copy the Variant ID (shown in the variant URL)
LS_VARIANT_STANDARD=111111
LS_VARIANT_PREMIUM=222222

# 5. Go to Settings → Webhooks → Add Endpoint
#    URL: https://vultacore.techprogression.com/api/billing/webhook
#    Events to subscribe: order_created, subscription_created, subscription_payment_success
#    Copy the Signing Secret shown after saving
LS_WEBHOOK_SECRET=your_webhook_signing_secret_here

# ─── Optional ────────────────────────────────────────────────────────────────
PORT=3001
