# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# Hostinger Passenger App Configuration
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
PassengerEnabled on
PassengerAppType node
PassengerStartupFile server.js

<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # If a real file exists in /out/, serve it (Next.js static files)
  RewriteCond %{DOCUMENT_ROOT}/out/%{REQUEST_URI} -f
  RewriteRule ^(.*)$ /out/$1 [L]

  # Otherwise, let Passenger handle it via Node.js
</IfModule>
