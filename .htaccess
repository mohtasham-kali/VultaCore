# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# VultaCore Routing
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # If a real file exists in /out/, serve it (Next.js static files)
  RewriteCond %{DOCUMENT_ROOT}/out/%{REQUEST_URI} -f
  RewriteRule ^(.*)$ /out/$1 [L]

  # Passenger (configured in hPanel) automatically handles routing to Node.js
  # We do not override it here.
</IfModule>
