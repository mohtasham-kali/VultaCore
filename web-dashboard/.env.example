# Paddle Billing
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_your_paddle_client_token
PADDLE_API_KEY=pdl_sdbx_apikey_your_api_key_here
PADDLE_SANDBOX_API_KEY=pdl_sdbx_apikey_your_api_key_here
PADDLE_NOTIFICATION_WEBHOOK_SECRET=pdl_ntfset_your_destination_secret_here
