  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "format",
          "value": "md"
        }
      ],
      "destination": "/api/markdown",
      "regex": "^/(?:/)?$"
    },
    {
      "source": "/api/:path*",
      "destination": "http://localhost:3001/api/:path*",
      "regex": "^/api(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "http://localhost:3001/socket.io/:path*",
