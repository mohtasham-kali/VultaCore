{
  "name": "vultacore-platform",
  "version": "1.0.0",
  "main": "server.js",
  "description": "Unified VultaCore Platform Monorepo",
  "private": true,
  "workspaces": [
    "web-dashboard",
    "backend-api",
    "desktop-app",
    "mobile-app"
  ],
  "scripts": {
    "build": "npm run build -w web-dashboard && npm run build -w backend-api && rm -rf ./out && cp -r web-dashboard/out ./out",
    "start": "node server.js"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/typeorm": "^11.0.0",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.13.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "next": "15.3.9",
    "pg": "^8.18.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28"
  }
}
