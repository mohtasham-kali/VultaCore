{
  "name": "vultacore-platform",
  "version": "1.0.0",
  "description": "Unified VultaCore Platform Monorepo",
  "private": true,
  "workspaces": [
    "web-dashboard",
    "backend-api",
    "desktop-app",
    "mobile-app"
  ],
  "scripts": {
    "build": "npm install && npm run build -w backend-api && npm run build -w web-dashboard && mkdir -p dist",
    "start": "node server.js"
  },
  "dependencies": {
    "@nestjs/core": "^11.0.1",
    "next": "^15.0.0"
  }
}
